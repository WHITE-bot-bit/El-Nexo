{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bye-tribunal-mia-experiments.trycloudflare.com/api/:path*"
    },
    {
      "source": "/src/:path*",
      "destination": "https://bye-tribunal-mia-experiments.trycloudflare.com/src/:path*"
    },
    {
      "source": "/examples/:path*",
      "destination": "https://bye-tribunal-mia-experiments.trycloudflare.com/examples/:path*"
    }
  ]
}